---
// Replays an illustrative voice-guide conversation once each time its slide is projected.
// All lines are in the HTML, so it reads fine without JS and for screen readers.
// The conversation is illustrative, not a transcript from the client system.
const lines = [
  { who: 'Visitor', text: 'Which animals are awake right now?', kind: 'user' },
  {
    who: 'Assistant',
    text: 'The elephants were just fed, so they are out and moving. Their habitat is about a five-minute walk from you.',
    kind: 'bot',
  },
  { who: 'Visitor', text: 'Is the marine park across town better than this place?', kind: 'user' },
  { who: '', text: 'Guardrail caught the reply mid-stream', kind: 'guard' },
  { who: 'Assistant', text: 'I can only help with your visit here. Want directions to the hippos?', kind: 'bot' },
];
---
<div class="replay facet-sm" role="log" aria-label="Replay of a voice assistant conversation" data-replay>
  {
    lines.map((l) =>
      l.kind === 'guard' ? (
        <p class="line guard">{l.text}</p>
      ) : (
        <p class:list={['line', l.kind]}>
          <span class="who">{l.who}</span>
          <span class="text">{l.text}</span>
        </p>
      ),
    )
  }
</div>

<style>
  .replay {
    flex: 1;
    background: rgba(255, 255, 255, 0.8);
    padding: 14px 16px;
    display: flex;
    flex-direction: column;
    gap: 7px;
    overflow: hidden;
  }
  .line {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1px;
  }
  .who {
    font-size: 11px;
    color: #5a636c;
  }
  .text {
    font-size: 13px;
    line-height: 1.35;
  }
  .user .text {
    color: #4a525b;
  }
  .guard {
    align-self: flex-start;
    background: var(--light-mint);
    border: 1px solid #9fcbb5;
    padding: 2px 10px;
    font-size: 12px;
    font-weight: 600;
    color: #12392c;
  }
  .replay.is-playing .line {
    opacity: 0;
    transform: translateY(4px);
  }
  .replay.is-playing .line.is-in {
    opacity: 1;
    transform: none;
    transition:
      opacity 320ms ease-out,
      transform 320ms ease-out;
  }
</style>

<script>
  // The projector dispatches `slide:shown` on a panel when it is projected.
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLElement>('[data-replay]').forEach((el) => {
    const panel = el.closest('[data-slide-panel]');
    if (!panel || reduce) return;
    let timers: number[] = [];
    panel.addEventListener('slide:shown', () => {
      timers.forEach(clearTimeout);
      timers = [];
      const lines = [...el.querySelectorAll<HTMLElement>('.line')];
      lines.forEach((l) => l.classList.remove('is-in'));
      el.classList.add('is-playing');
      lines.forEach((line, i) => timers.push(window.setTimeout(() => line.classList.add('is-in'), 900 + i * 1000)));
    });
  });
</script>
